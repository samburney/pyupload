<div class="uploaded-file-item grid grid-cols-subgrid col-span-2 gap-1 items-center">
    <div class="flex justify-center">
        <div class="relative group/thumbnail flex w-fit isolate">
            <div class="absolute top-0 left-0 w-full h-full rounded-sm overflow-hidden -z-1">
                <div style="width: 0%;" class="h-full bg-blue-500 transition-[width] ease-in-out duration-200"
                    data-dz-uploadprogress></div>
            </div>
            <div class="rounded-sm p-0.5"
                data-dz-thumbnail-container>
                <svg viewBox="0 0 24 24" class="w-13 h-13 fill-gray-300"
                    aria-hidden="true"
                    data-dz-thumbnail-placeholder>
                    <use href="{{ request.url_for('static', path='css/lib/n3r4zzurr0/svg-spinners/svg-css/blocks-shuffle-3.svg') }}"></use>
                </svg>
            </div>
            <div class="flex opacity-0 top-0 left-0 w-full h-full group-hover/thumbnail:opacity-100 transition-all">
                <div class="absolute flex top-0 left-0 w-full h-full items-center justify-center bg-white opacity-75"></div>
                <div class="absolute flex top-0 left-0 w-full h-full items-center justify-center">
                    <button type="button" class="p-1 rounded-full cursor-pointer fill-red-500 hover:fill-white hover:bg-red-500"
                        data-dz-remove
                        aria-label="Remove file">
                        <svg class="size-5" aria-hidden="true">
                            <use href="#material-symbols-outlined-cancel"></use>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="grid text-xs min-w-0 content-evenly self-stretch">
        <div class="overflow-hidden overflow-ellipsis whitespace-nowrap font-semibold" data-dz-name></div>
        <div class="flex gap-2">
            <div class="flex gap-0.5 text-gray-700">
                <svg class="size-4 fill-gray-700" aria-hidden="true"><use href="#material-symbols-outlined-storage"></use></svg>
                <span data-dz-size></span>
            </div>
            <div class="flex gap-0.5 text-gray-700">
                <svg class="size-4 fill-gray-700" aria-hidden="true"><use href="#material-symbols-outlined-unknown-document"></use></svg>
                <span data-dz-type></span>
            </div>
        </div>
    </div>
</div>
