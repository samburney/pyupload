<div id="file-upload-widget" class="relative"
    x-data="fileUploadWidget">
    <div class="flex flex-col w-full items-center rounded-md border border-gray-100 shadow-sm shadow-gray-300 text-gray-900
            hover:shadow-lg hover:outline-2 hover:outline-blue-500
            has-[.dz-drag-hover]:shadow-lg has-[.dz-drag-hover]:border-2 has-[.dz-drag-hover]:border-blue-500 has-[.dz-drag-hover]:border-dashed">   
        <form id="upload-form"
            action="{{ request.url_for('upload_create_post') }}"
            method="post"
            enctype="multipart/form-data"
            class="w-full p-1 md:p-4"
            data-max-file-size="{{ max_file_size_mb }}"
            {% if accepted_files != '*' %}data-accepted-files="{{ accepted_files }}"{% endif %}>
            <div id="browse-files-button" class="flex flex-col gap-4 items-center">
                <svg class="size-12 mt-4"><use href="#material-symbols-outlined-place-item"></use></svg>
                <span class="text-xs text-center"
                    x-html="isLoaded ? 'Drop, paste or click<br>to upload files' : 'Loading...'">
                    Loading...
                </span>
            </div>
        </form>
    </div>
    <div id="uploaded-files-list" class="w-full mt-2"
        x-show="fileCount > 0"
        x-cloak>
        <div id="uploaded-file-item-container" class="grid grid-cols-[auto_1fr] my-1 gap-0.5"></div>
    </div>
    <div class="flex justify-center">
        <button type="button" class="button button-md lg:button" disabled
            x-show="pendingCount > 0"
            x-cloak
            :disabled="pendingCount === 0"
            :class="{ 'button-disabled': pendingCount === 0 }"
            @click="dzInst.processQueue();">
            Upload
        </button>
    </div>
    <template id="uploaded-file-item-template">
        <div class="grid grid-cols-subgrid col-span-2 gap-1 items-center">
            <div class="relative group/thumbnail flex justify-center">
                <img class="rounded-sm max-w-18 max-h-13 shadow-sm border border-gray-300 p-0.5"
                    data-dz-thumbnail>
                <div class="absolute flex opacity-0 top-0 left-0 w-full h-full group-hover/thumbnail:opacity-100 transition-all">
                    <div class="absolute flex top-0 left-0 w-full h-full items-center justify-center bg-white opacity-75"></div>
                    <div class="absolute flex top-0 left-0 w-full h-full items-center justify-center">
                        <button class="cursor-pointer hover:fill-red-500"
                            data-dz-remove>
                            <svg class="size-5">
                                <use href="#material-symbols-outlined-cancel"></use>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
            <div class="grid text-xs min-w-0 content-evenly self-stretch">
                <div class="overflow-hidden overflow-ellipsis whitespace-nowrap font-semibold" data-dz-name></div>
                <div class="flex gap-2">
                    <div class="flex gap-0.5 text-gray-700">
                        <svg class="size-4 fill-gray-700"><use href="#material-symbols-outlined-storage"></use></svg>
                        <span data-dz-size></span>
                    </div>
                    <div class="flex gap-0.5 text-gray-700">
                        <svg class="size-4 fill-gray-700"><use href="#material-symbols-outlined-unknown-document"></use></svg>
                        <span data-dz-type></span>
                    </div>
                </div>
            </div>
        </div>
    </template>
