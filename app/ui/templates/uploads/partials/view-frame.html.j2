<article class="flex flex-col w-full grow min-w-0 items-center justify-start">
    {% if upload.is_image %}
    <div class="p-2 border border-gray-100 shadow-md shadow-gray-300 rounded-md">
        <a href="{{ upload.url }}" target="_blank">
            <div class="relative image-position-locator"
                {%- if placeholder_image_width and placeholder_image_height %}
                style="{{ 'width: ' + placeholder_image_width | string + 'px;' if placeholder_image_width else '' }} {{ 'height: ' + placeholder_image_height | string + 'px;' if placeholder_image_height else '' }}"
                {%- endif %}
                x-data="{loaded: false}" x-init="loaded = $el.querySelector('img')?.complete || false;">
                {%- set placeholder_container = "document.querySelector('main').querySelector('article')" %}
                {%- set placeholder_ignore_height = True %}
                <div id="view-frame-image"
                    hx-get="/uploads/{{ upload.id }}/image?context=frame"
                    hx-vals="js:{ ...calculateMaxImageSize({{ upload.image.width }}, {{ upload.image.height }}, document.querySelector('main').querySelector('article'), true) }"
                    hx-trigger="load"
                    hx-swap="outerHTML">
                    {% include "components/core/image-placeholder.html.j2" %}
                </div>
                <div id="loading-indicator" class="htmx-indicator hidden absolute top-0 left-0 w-full h-full items-center justify-center bg-black/75">
                    <svg class="size-12 animate-spin" fill="none" viewBox="0 0 24 24">
                        <use href="#icon-loading-spinner"></use>
                    </svg>
                </div>
            </div>
        </a>
    </div>
    {% else %}
    <a class="block border border-dashed text-gray-600 hover:text-gray-400 border-gray-600 hover:border-gray-400 rounded-md object-cover w-16 h-16 mx-auto"
        aria-label="Download {{ upload.display_name }}"
        href="{{ upload.url }}">
        <div class="flex items-end justify-end h-full w-full p-2">
            {{ upload.dot_ext }}
        </div>
    </a>
    {% endif %}
    <div class="w-full px-4">
        <p class="text-sm text-gray-600 mt-2 text-center whitespace-nowrap overflow-hidden text-ellipsis" title="{{ upload.filename }}">
            {{ upload.originalname }}{{ upload.dot_ext }}
        </p>
    </div>
</article>