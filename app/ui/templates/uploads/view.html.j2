{% extends "layout/base.html.j2" %}

{% block content %}
{%- set display_title = upload.description or upload.originalname %}
<div class="flex flex-row gap-4 mb-4 mt-2">
    <article class="flex flex-col w-full md:w-3/4 items-center justify-center">
        {% if upload.is_image %}
        <div class="p-2 border border-gray-100 shadow-md shadow-gray-300 rounded-md">
            <a href="{{ upload.url }}" target="_blank">
                <img src="{{ upload.url }}" alt="{{ display_title }}">
            </a>
        </div>
        {% else %}
        <a class="block border border-dashed text-gray-600 hover:text-gray-400 border-gray-600 hover:border-gray-400 rounded-md object-cover w-16 h-16 mx-auto"
            aria-label="Download {{ display_title }}"
            href="{{ upload.url }}">
            <div class="flex items-end justify-end h-full w-full p-2">
                {{ upload.dot_ext }}
            </div>
        </a>
        {% endif %}
    </article>
    <nav class="hidden md:flex flex-col gap-4 w-1/4 items-center">
        <div class="flex w-full items-center justify-center">
            {% if upload.is_image %}
            <div x-data="{ open: false }"
                 class="dropdown">
                <span class="button button-ok">
                    <a class="dropdown-button" href="{{ upload.download_url }}">
                        Download
                    </a>

                    <button class="dropdown-button"
                            type="button"
                            aria-label="Menu"
                            @click="open = !open"
                            @mouseover="open = true">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
                        </svg>
                    </button>
                </span>

                <ul role="menu"
                    class="menu"
                    aria-label="Download options"
                    x-cloak
                    x-show="open"
                    x-transition
                    @click.outside="open = false">
                    <li role="menuitem" class="menu-item">
                        <a href="{{ upload.download_url }}">
                            Download Original
                        </a>
                    </li>
                    {% if upload.type != "image/jpeg" %}
                    <li role="menuitem" class="menu-item">
                        <a href="{{ upload.download_url | split_filename | first }}.jpg">
                            Download as JPG
                        </a>
                    </li>
                    {% endif %}
                    {% if upload.type != "image/gif" %}
                    <li role="menuitem" class="menu-item">
                        <a href="{{ upload.download_url | split_filename | first }}.gif">
                            Download as GIF
                        </a>
                    </li>
                    {% endif %}
                    {% if upload.type != "image/png" %}
                    <li role="menuitem" class="menu-item">
                        <a href="{{ upload.download_url | split_filename | first }}.png">
                            Download as PNG
                        </a>
                    </li>
                    {% endif %}
                </ul>
            </div>
            {% else %}
            <a class="button button-ok" href="{{ upload.download_url }}">
                Download
            </a>
            {% endif %}
        </div>
        <div class="flex flex-col w-full gap-2 p-3 bg-gray-100 border border-gray-200 shadow-inner shadow-gray-300 rounded-md">
            <p class="text-sm lg:text-base font-medium break-all">
                {{ display_title }}
            </p>
            <dl class="flex flex-col gap-0.5 ml-1 mt-2">
                <dd class="sm:inline-flex sm:shrink-0 sm:items-center sm:gap-2">
                    {% if not upload.private %}
                    <svg class="md:size-3 lg:size-4{% if current_user and upload.user.id == current_user.id %} text-blue-600{% else %} text-gray-700{% endif %}"
                        viewBox="0 0 24 24">
                        <use href="#icon-user-public"></use>
                    </svg>
                    {% else %}
                    <svg class="md:size-3 lg:size-4 text-green-400" viewBox="0 0 32 32">
                        <use href="#icon-user-private"></use>
                    </svg>
                    {% endif %}
                    <div class="text-xs lg:text-sm mt-1.5 sm:mt-0">
                        <p>{{ upload.user.username }}</p>
                    </div>
                </dd>
                <dd class="sm:inline-flex sm:shrink-0 sm:items-center sm:gap-2">
                    <svg class="md:size-3 lg:size-4 text-gray-500" viewBox="0 0 32 32">
                        <use href="#icon-file-type"></use>
                    </svg>
                    <div class="text-xs lg:text-sm mt-1.5 sm:mt-0">
                        <p>{{ upload.type }}</p>
                    </div>
                </dd>
                <dd class="sm:inline-flex sm:shrink-0 sm:items-center sm:gap-2">
                    <svg class="md:size-3 lg:size-4 text-gray-500" viewBox="0 0 24 24">
                        <use href="#icon-file-size"></use>
                    </svg>
                    <div class="text-xs lg:text-sm mt-1.5 sm:mt-0">
                        <p>{{ upload.size | humanize_bytes }}</p>
                    </div>
                </dd>
                <dd class="sm:inline-flex sm:shrink-0 sm:items-center sm:gap-2">
                    <svg class="md:size-3 lg:size-4 text-gray-500" viewBox="0 0 122.88 68.18">
                        <use href="#icon-view-count"></use>
                    </svg>
                    <div class="text-xs lg:text-sm mt-1.5 sm:mt-0">
                        <p>{{ upload.viewed }}</p>
                    </div>
                </dd>
                <dd class="sm:inline-flex sm:shrink-0 sm:items-center sm:gap-2">
                    <svg class="md:size-3 lg:size-4 text-gray-500" viewBox="0 0 122.88 122.88">
                        <use href="#icon-calendar"></use>
                    </svg>
                    <div class="text-xs lg:text-sm mt-1.5 sm:mt-0">
                        <p>{{ upload.created_at | ago }}</p>
                    </div>
                </dd>
                {% if upload.is_image %}
                <dd class="sm:inline-flex sm:shrink-0 sm:items-center sm:gap-2 mt-4">
                    <svg class="md:size-3 lg:size-4 text-gray-500" viewBox="0 0 122.88 122.88">
                        <use href="#icon-image-dimensions"></use>
                    </svg>
                    <div class="text-xs lg:text-sm mt-1.5 sm:mt-0">
                        <p>{{ upload.image.width }}x{{ upload.image.height }}</p>
                    </div>
                </dd>
                {% endif %}
            </dl>
        </div>
    </nav>
</div>
{% endblock %}
