{%- extends "layout/base.html.j2" %}

{%- from "components/gallery/multiselect-chrome.html.j2" import render_multiselect_chrome with context %}

{%- block content %}
{% call render_multiselect_chrome() %}
<div class="flex flex-row grow">
    <div class="grow min-w-0">
        {%- include("/gallery/partials/grid.html.j2") %}
        {%- include("/gallery/partials/pagination.html.j2") %}
    </div>
    <div class="flex-none w-0 opacity-0 ml-0 overflow-hidden transition-[width] ease-in-out"
        :class="selectedCount > 0 ? 'opacity-100 ml-2 w-40 lg:ml-4 lg:w-64' : ''">
        <div class="w-40 lg:w-64">
            {%- include("/gallery/partials/sidebar.html.j2") %}
        </div>
    </div>
</div>
{% endcall %}
{% endblock %}
