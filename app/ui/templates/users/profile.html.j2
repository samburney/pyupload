{% extends "layout/base.html.j2" %}

{% block content %}
<h1>Profile</h1>
<h2>{{ current_user.username }}</h2>
<p class="mt-4 mb-2"><strong>Actions</strong></p>
<ul>
    <li><a href="/logout">Logout</a></li>
    <li><a href="/logout-all">Logout All Sessions</a></li>
</ul>
{% if uploads | length > 0 %}
<h2 class="mt-4 mb-2">Uploads</h2>
{% include "components/gallery/grid.html.j2" %}
{% endif %}
{% if download_archives | length > 0 %}
<h2 class="mt-4 mb-2">Download Archives</h2>
{% include "archives/partials/profile-list.html.j2" %}
{% endif %}
{% endblock %}
