<div id="upload-details"
        class="flex flex-col w-full gap-2 p-3 bg-gray-100 border border-gray-200 shadow-inner shadow-gray-300 rounded-md">
    {% include "components/uploads/description.html.j2" %}
    <dl class="flex flex-col gap-0.5 ml-1 mt-2">
        <dd class="inline-flex shrink-0 items-center gap-2">
            {% if not upload.private %}
            <svg class="size-3 lg:size-4{% if current_user and upload.user.id == current_user.id %} text-blue-600{% else %} text-gray-700{% endif %}"
                viewBox="0 0 24 24">
                <use href="#icon-user-public"></use>
            </svg>
            {% else %}
            <svg class="size-3 lg:size-4 text-green-400" viewBox="0 0 32 32">
                <use href="#icon-user-private"></use>
            </svg>
            {% endif %}
            <div class="text-xs lg:text-sm mt-0">
                <p>{{ upload.user.username }}</p>
            </div>
        </dd>
        <dd class="inline-flex shrink-0 items-center gap-2">
            <svg class="size-3 lg:size-4 text-gray-500" viewBox="0 0 32 32">
                <use href="#icon-file-type"></use>
            </svg>
            <div class="text-xs lg:text-sm mt-0">
                <p>{{ upload.type }}</p>
            </div>
        </dd>
        <dd class="inline-flex shrink-0 items-center gap-2">
            <svg class="size-3 lg:size-4 text-gray-500" viewBox="0 0 24 24">
                <use href="#icon-file-size"></use>
            </svg>
            <div class="text-xs lg:text-sm mt-0">
                <p>{{ upload.size | humanize_bytes }}</p>
            </div>
        </dd>
        <dd class="inline-flex shrink-0 items-center gap-2">
            <svg class="size-3 lg:size-4 text-gray-500" viewBox="0 0 122.88 68.18">
                <use href="#icon-view-count"></use>
            </svg>
            <div class="text-xs lg:text-sm mt-0">
                <p>{{ upload.viewed }}</p>
            </div>
        </dd>
        <dd class="inline-flex shrink-0 items-center gap-2">
            <svg class="size-3 lg:size-4 text-gray-500" viewBox="0 0 122.88 122.88">
                <use href="#icon-calendar"></use>
            </svg>
            <div class="text-xs lg:text-sm mt-0">
                <p>{{ upload.created_at | ago }}</p>
            </div>
        </dd>
        {% if upload.is_image %}
        <dd class="inline-flex shrink-0 items-center gap-2 mt-2 pt-2 border-t border-t-gray-300">
            <svg class="size-3 lg:size-4 text-gray-500" viewBox="0 0 122.88 122.88">
                <use href="#icon-image-dimensions"></use>
            </svg>
            <div class="text-xs lg:text-sm mt-0">
                <p>{{ upload.image.width }}x{{ upload.image.height }}</p>
            </div>
        </dd>
        {% endif %}
    </dl>
</div>
