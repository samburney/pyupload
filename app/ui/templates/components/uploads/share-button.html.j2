{% from "components/core/modal-basic.html.j2" import render_modal with context %}
<div class="flex items-center"
    x-data="{ open: false }">
    <button class="button max-h-8.5 px-1.5 lg:max-h-fit lg:px-2 m-0 rounded-md flex items-center"
        @click="open = true">
        <svg class="size-3.5 lg:size-5.5 fill-white" aria-hidden="true"><use href="#material-symbols-outlined-share"></use></svg>
    </button>
    {% call render_modal(title='Share upload') %}
    <p class="-mt-4">{{ upload.description }}{{ upload.dot_ext }}</p>
    <div class="flex flex-col gap-2 w-full mt-2">
        {% if not upload.is_private %}
        {% if upload.is_image %}
        <label for="shareable-image" class="w-full">
            <span class="text-sm text-gray-500">Direct image URL:</span>
            <div class="flex w-full gap-2 items-center">
                <input id="shareable-image" type="text" readonly
                    class="w-full border rounded-md bg-gray-100 text-sm text-gray-800"
                    value="{{ upload.url }}">
                <button class="button"
                    @click="$clipboard(htmx.find('#shareable-image').value); $el.classList.add('button-ok'); setTimeout(() => $el.classList.remove('button-ok'), 2000);">
                    <svg class="size-5 fill-white" aria-hidden="true">
                        <use href="#material-symbols-outlined-copy"></use>
                    </svg>
                </button>
            </div>
        </label>
        {% endif %}
        <label for="shareable-page">
            <span class="text-sm text-gray-500">Upload details URL:</span>
            <div class="flex w-full gap-2 items-center">
                <input id="shareable-page" type="text" readonly
                    class="w-full border rounded-md bg-gray-100 text-sm text-gray-800"
                    value="{{ upload.view_url }}">
                <button class="button"
                    @click="$clipboard(htmx.find('#shareable-page').value); $el.classList.add('button-ok'); setTimeout(() => $el.classList.remove('button-ok'), 2000);">
                    <svg class="size-5 fill-white" aria-hidden="true">
                        <use href="#material-symbols-outlined-copy"></use>
                    </svg>
                </button>
            </div>
        </label>
        <label for="shareable-download">
            <span class="text-sm text-gray-500">Direct download URL:</span>
            <div class="flex w-full gap-2 items-center">
                <input id="shareable-download" type="text" readonly
                    class="w-full border rounded-md bg-gray-100 text-sm text-gray-800"
                    value="{{ upload.download_url }}">
                <button class="button"
                    @click="$clipboard(htmx.find('#shareable-download').value); $el.classList.add('button-ok'); setTimeout(() => $el.classList.remove('button-ok'), 2000);">
                    <svg class="size-5 fill-white" aria-hidden="true">
                        <use href="#material-symbols-outlined-copy"></use>
                    </svg>
                </button>
            </div>
        </label>
    {% else %}
        <p class="text-gray-700">This upload is private. Only you can access it.</p>
    {% endif %}
    </div>
    {% endcall %}
</div>