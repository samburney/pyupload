<div class="bg-gray-200 animate-pulse flex items-center justify-center rounded-none sm:rounded-md"
    x-show="!loaded && ready" x-data="imagePlaceholder({{ upload.image.width }}, {{ upload.image.height }}, {{ placeholder_container|default('window') }}, {{ 'true' if placeholder_sidebar else 'false' }})"
    x-effect="if (ready) $dispatch('placeholder-ready')"
    x-cloak
    @resize.window="!loaded && calculateSize()"
    :style="`width: ${width}px; height: ${height}px;`">
    <svg class="text-gray-400 size-24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none"
        viewBox="0 0 24 24">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="m3 16 5-7 6 6.5m6.5 2.5L16 13l-4.286 6M14 10h.01M4 19h16a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1Z" />
    </svg>
</div>