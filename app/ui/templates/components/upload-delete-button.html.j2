{% from "components/modal-dialog.html.j2" import render_dialog %}
<div x-data="{ open: false }"
    class="w-full">
    <button @click="open = true"
            type="button"
            class="px-4 py-2 w-full text-left rounded-md outline-1 outline-red-100 shadow-md hover:text-red-600 hover:bg-red-200 cursor-pointer">
        Delete
    </button>
    {% call render_dialog(title='Confirm delete', content='Are you sure you wish to permanently delete this file?') %}
    <button hx-delete="/uploads/{{ upload.id }}"
            type="button"
            class="button button-alert">
        Delete
    </button>
    <button @click="open = false"
            type="button"
            class="button button-outline">
        Cancel
    </button>
    {% endcall %}
</div>
