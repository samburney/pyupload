{% macro render_modal(title) %}
<div x-show="open"
     x-cloak
     x-transition.opacity.duration.300ms
     @click="open = false"
     class="fixed inset-0 z-50 grid place-content-center bg-black/50 p-4"
     role="dialog"
     aria-modal="true"
     aria-labelledby="modalTitle">
  <div @click.stop
       class="w-full max-w-md rounded-lg bg-white p-6 shadow-lg">
    <div class="flex items-start justify-between">
      <h2 id="modalTitle" class="text-xl font-bold text-gray-900 sm:text-2xl">
        {{ title }}
      </h2>

      <button @click="open = false"
              type="button"
              class="-me-4 -mt-4 rounded-full bg-black/25 p-1 text-white hover:bg-black/50 transition-colors"
              aria-label="Close">
        <svg class="size-5" aria-hidden="true">
          <use href="#material-symbols-outlined-close"></use>
        </svg>
      </button>
    </div>

    <div class="mt-4">
      <p class="text-pretty text-gray-700">
        {{ caller() }}
      </p>
    </div>
  </div>
</div>
{% endmacro %}
