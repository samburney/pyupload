{% if stacks and stacks | length > 0 %}
<article id="stack-grid"
    class="columns-1 md:columns-2 xl:columns-3 2xl:columns-4 gap-4 mb-4">
    {% for stack in stacks %}
    {% include("components/common/stack-card.html.j2") %}
    {% endfor %}
</article>
{% else %}
<article id="stack-grid" class="flex flex-col grow justify-center items-center">
    {% include("components/common/empty-content.html.j2") %}
</article>
{% endif %}
