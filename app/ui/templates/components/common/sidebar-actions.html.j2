{% include "components/tags/macro_input.html.j2" %}
{% set tags = upload.tags %}
{% from "components/tags/macro_input.html.j2" import render_tags_input, render_tags_readonly with context %}
{% include "components/collections/macro_combo-selector.html.j2" %}
{% set selected_collections = upload.collections %}
{% set filtered_collections = upload.filtered_collections %}
{% from "components/collections/macro_combo-selector.html.j2" import render_combo_selector with context %}
<div class="flex flex-col w-full gap-2 p-3 bg-gray-100 border border-gray-200 shadow-inner shadow-gray-300 rounded-md">
    {%- if current_user %}
    <div>{{ render_tags_input() }}</div>
    <div>{{ render_combo_selector() }}</div>
    {%- else %}
    <div>{{ render_tags_readonly() }}</div>
    {%- endif %}
    {%- if upload.is_writable %}
        <p class="mt-2 text-xs text-gray-700 font-medium">Actions</p>
        <div class="flex flex-col w-full gap-2">
            {%- if upload.is_image %}
                {%- include "components/common/rotate-button.html.j2" %}
            {%- endif %}
            {%- include "components/common/delete-button.html.j2" %}
            {%- include "components/common/private-toggle.html.j2" %}
        </div>
    {%- endif %}
</div>
