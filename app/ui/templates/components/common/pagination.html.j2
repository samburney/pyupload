{% if pagination is defined and pagination.pages > 1 %}
<div class="pagination">
    <ul class="flex gap-1 text-gray-900">
        <li>
            {% if pagination.page > 1 %}
            <a href="{{ pagination.page_url(pagination.page - 1) }}" aria-label="Previous page" class="page-item next-previous-page justify-items-center" hx-boost>
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
            </a>
            {% else %}
            <span class="page-item page-item-disabled next-previous-page justify-items-center" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
            </span>
            {% endif %}
        </li>

        {% for page in range(1, pagination.pages + 1) %}
        <li>
        {% if page == pagination.page %}
            <span class="page-item page-item-active" aria-current="page">
            {{ page }}
            </span>
        {% else %}
            <a href="{{ pagination.page_url(page) }}" class="page-item" hx-boost>
            {{ page }}
            </a>
        {% endif %}
        </li>
        {% endfor %}

        <li>
            {% if pagination.page < pagination.pages %}
            <a href="{{ pagination.page_url(pagination.page + 1) }}" aria-label="Next page" class="page-item next-previous-page justify-items-center" hx-boost>
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                </svg>
            </a>
            {% else %}
            <span class="page-item page-item-disabled next-previous-page justify-items-center" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                </svg>
            </span>
            {% endif %}
        </li>
    </ul>
</div>
{% endif %}