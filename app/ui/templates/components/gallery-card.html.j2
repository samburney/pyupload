<div class="rounded-lg p-3 mb-4 border border-gray-100 shadow-sm shadow-gray-300
            h-min break-inside-avoid-column flex-col justify-center transition-all
            duration-150 hover:shadow-md hover:shadow-gray-300 hover:scale-101">
    {%- set display_title = upload.description or upload.originalname %}
    {% if upload.image %}
    {%- set ar_decimal = (upload.image.width / upload.image.height) | round(3) %}
    {%- set thumb_max_width = 640 %}
    {%- set thumb_max_height = (thumb_max_width / ar_decimal) | round(0, 'ceil') | int %}
    <a href="{{ upload.view_url }}" hx-get="{{ upload.view_url }}?modal=true" hx-select=".modal-image" hx-target="body"
        hx-swap="beforeend" hx-select-oob="#messages" hx-target-4*="#messages" x-data="{ loaded: false }"
        x-init="loaded = $el.querySelector('img')?.complete || false" class="relative"
        aria-label="{{ upload.image.width }}x{{ upload.image.height }} Open upload {{ display_title }}">
        <div class="space-y-8 animate-pulse md:space-y-0 md:space-x-8 rtl:space-x-reverse md:flex md:items-center text-gray-500"
            x-show="!loaded">
            <div class="flex items-center justify-center w-full bg-neutral-quaternary rounded-base bg-gray-200 rounded-md"
                style="max-width: {{ thumb_max_width }}px; aspect-ratio: {{ ar_decimal }};">
                <svg class="text-fg-disabled" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24">
                    <use href="#icon-placeholder-image"></use>
                </svg>
            </div>
        </div>
        <img class="h-min w-full rounded-md transition-normal duration-150 hover:brightness-80"
             alt="{{ display_title }}"
             {% if upload.image.supports_processing %}
             src="{{ upload.url | split_filename | first }}-{{ thumb_max_width }}x0.jpg"
             {% else %}
             src="{{ upload.url }}"
             {% endif %}
             x-show="loaded"
             x-transition.opacity.duration.150ms
             x-cloak
             @load="loaded = true">
        {% if upload.image %}
        <div class="absolute bottom-0 right-0 flex flex-row w-full">
            <div
                class="flex flex-row grow gap-2 mb-2 items-center text-gray-100 bg-linear-to-r from-black/0 from-60% to-black/30 pr-2 py-0.5">
            </div>
            <div class="flex flex-row gap-2 mb-2 items-center text-gray-100 bg-black/30 pr-3 py-0.5">
                <svg class="size-4 fill-gray-100" viewBox="0 0 24 24">
                    <use href="#icon-image-dimensions"></use>
                </svg>
                <div class="mt-1.5 sm:mt-0">
                    <p class="text-xs font-medium">{{ upload.image.width }}x{{ upload.image.height }}</p>
                </div>
            </div>
        </div>
        {% endif %}
    </a>
    {% else %}
    <a class="block border border-dashed text-gray-600 hover:text-gray-400 border-gray-600 hover:border-gray-400 rounded-md object-cover w-16 h-16 mx-auto"
        aria-label="Download {{ display_title }}"
        href="{{ upload.url }}">
        <div class="flex items-end justify-end h-full w-full p-2">
            {{ upload.dot_ext }}
        </div>
    </a>
    {% endif %}
    <div class="mt-2">
        <dl>
            <div class="flex flex-wrap items-center gap-2 text-xs text-gray-500 mt-2">
                <dd class="sm:inline-flex sm:shrink-0 sm:items-center sm:gap-1">
                    {% if not upload.private %}
                    <svg class="size-4{% if current_user and upload.user.id == current_user.id %} text-blue-600{% else %} text-gray-700{% endif %}"
                        viewBox="0 0 24 24">
                        <use href="#icon-user-public"></use>
                    </svg>
                    {% else %}
                    <svg class="size-4 text-green-400" viewBox="0 0 32 32">
                        <use href="#icon-user-private"></use>
                    </svg>
                    {% endif %}
                    <p class="font-medium">{{ upload.user.username }}</p>
                </dd>
                <dd class="sm:inline-flex sm:shrink-0 sm:items-center sm:gap-1">
                    <svg class="size-4 text-gray-500" viewBox="0 0 32 32">
                        <use href="#icon-file-type"></use>
                    </svg>
                    <div class="mt-1.5 sm:mt-0">
                        <p class="font-medium">{{ upload.short_type }}</p>
                    </div>
                </dd>
                <dd class="sm:inline-flex sm:shrink-0 sm:items-center sm:gap-1">
                    <svg class="size-4 text-gray-500" viewBox="0 0 24 24">
                        <use href="#icon-file-size"></use>
                    </svg>
                    <div class="mt-1.5 sm:mt-0">
                        <p class="font-medium">{{ upload.size | humanize_bytes }}</p>
                    </div>
                </dd>
                <dd class="sm:inline-flex sm:shrink-0 sm:items-center sm:gap-1">
                    <svg class="size-4 text-gray-500" viewBox="0 0 122.88 68.18">
                        <use href="#icon-view-count"></use>
                    </svg>
                    <div class="mt-1.5 sm:mt-0">
                        <p class="font-medium">{{ upload.viewed }}</p>
                    </div>
                </dd>
                <dd class="sm:inline-flex sm:shrink-0 sm:items-center sm:gap-1">
                    <svg class="size-4 text-gray-500" viewBox="0 0 122.88 122.88">
                        <use href="#icon-calendar"></use>
                    </svg>
                    <div class="mt-1.5 sm:mt-0">
                        <p class="font-medium">{{ upload.created_at | ago }}</p>
                    </div>
                </dd>
            </div>
            <div class="mt-2">
                <dd class="text-md overflow-hidden overflow-ellipsis whitespace-nowrap"
                    title="{{ display_title }}">{{ display_title }}</dd>
            </div>
        </dl>
    </div>
</div>