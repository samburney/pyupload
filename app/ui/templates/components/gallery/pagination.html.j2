{% if pagination is defined and pagination.pages > 1 %}
{% if pagination.seed %}
<input name="ps" type="hidden" value="{{ pagination.seed }}">
{% endif %}
<div id="pagination" class="pagination">
    {%- if pagination.infinite_scroll %}
    {%- if pagination.page < pagination.pages %}
    <div class="h-1"
        hx-trigger="revealed once"
        hx-get="{{ pagination.page_url(pagination.page + 1) }}"
        hx-target="#gallery-grid"
        hx-select="#gallery-grid > .group\/card"
        {%- if pagination.seed %}
        hx-include="input[name='ps']"
        {%- endif %}
        hx-swap="beforeend"
        hx-select-oob="#messages,#pagination"
        hx-indicator="next .htmx-indicator">
    </div>
    <div class="hidden gap-2 htmx-indicator">
        <span class="size-3 animate-pulse rounded-full bg-indigo-600"></span>
        <span class="size-3 animate-pulse rounded-full bg-indigo-600 [animation-delay:0.2s]"></span>
        <span class="size-3 animate-pulse rounded-full bg-indigo-600 [animation-delay:0.4s]"></span>
    </div>
    {%- endif %}
    {%- else %}
    <ul class="flex gap-1 text-gray-900">
        <li>
            {% if pagination.page > 1 %}
            <a href="{{ pagination.page_url(pagination.page - 1) }}" aria-label="Previous page" class="page-item next-previous-page justify-items-center"
                hx-get="{{ pagination.page_url(pagination.page - 1) }}"
                hx-target="#gallery-grid"
                hx-select="#gallery-grid"
                {%- if pagination.seed %}
                hx-include="input[name='ps']"
                {%- endif %}
                hx-swap="outerHTML show:window:top"
                hx-select-oob="#messages,#pagination"
                hx-push-url="true">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
            </a>
            {% else %}
            <span class="page-item page-item-disabled next-previous-page justify-items-center" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
            </span>
            {% endif %}
        </li>

        {% for page in range(1, pagination.pages + 1) %}
        <li>
        {% if page == pagination.page %}
            <span class="page-item page-item-active" aria-current="page">
            {{ page }}
            </span>
        {% else %}
            <a href="{{ pagination.page_url(page) }}" class="page-item"
                hx-get="{{ pagination.page_url(page) }}"
                hx-target="#gallery-grid"
                hx-select="#gallery-grid"
                {%- if pagination.seed %}
                hx-include="input[name='ps']"
                {%- endif %}
                hx-swap="outerHTML show:window:top"
                hx-select-oob="#messages,#pagination"
                hx-push-url="true">
            {{ page }}
            </a>
        {% endif %}
        </li>
        {% endfor %}

        <li>
            {% if pagination.page < pagination.pages %}
            <a href="{{ pagination.page_url(pagination.page + 1) }}" aria-label="Next page" class="page-item next-previous-page justify-items-center"
                hx-get="{{ pagination.page_url(pagination.page + 1) }}"
                hx-target="#gallery-grid"
                hx-select="#gallery-grid"
                {%- if pagination.seed %}
                hx-include="input[name='ps']"
                {%- endif %}
                hx-swap="outerHTML show:window:top"
                hx-select-oob="#messages,#pagination"
                hx-push-url="true">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                </svg>
            </a>
            {% else %}
            <span class="page-item page-item-disabled next-previous-page justify-items-center" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                </svg>
            </span>
            {% endif %}
        </li>
    </ul>
    {% endif %}
</div>
{% endif %}
