{% if uploads and uploads | length > 0 %}
<div x-data="handleSelectedUploads">
    <div class="grid transition-[grid-template-rows]"
        :class="selectedCount > 0 ? 'grid-rows-[1fr] mb-2' : 'grid-rows-[0fr] mb-0'">
        <div class="overflow-hidden">
            <div id="uploads-selected-bar"
                class="flex w-full items-center py-2 px-4 mb-2 gap-2 border border-blue-300 rounded-md shadow-md shadow-blue-100 justify-between transition-all duration-200"
                x-cloak
                x-transition
                x-show="selectedCount > 0"
                :class="pulse ? 'shadow-lg bg-blue-100' : 'shadow-md bg-white'">
                <div class="text-lg block">
                    <span x-text="selectedCount"></span>
                    <span>Selected</span>
                </div>
                <div class="flex">
                    <button class="hover:fill-gray-700 hover:shadow-md p-2"
                        @click="clearSelection()">
                        <svg class="size-6">
                            <use href="#material-symbols-outlined-remove-done"></use>
                        </svg>
                    </button>
                    <button class="hover:fill-gray-700 hover:shadow-md p-2">
                        <svg class="size-6">
                            <use href="#material-symbols-outlined-done-all"></use>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <article class="columns-1 md:columns-2 xl:columns-3 2xl:columns-4 gap-4 mb-4">
        {% for upload in uploads %}
        {% include("components/gallery/card.html.j2") %}
        {% endfor %}
    </article>
</div>
{% else %}
<article class="flex flex-col grow justify-center items-center">
    {% include("components/core/empty-content.html.j2") %}
</article>
{% endif %}
