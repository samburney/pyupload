{% from "components/gallery/macro_download-button-format-item.html.j2" import multiselect_download_button_format_item with context %}
{% include "components/common/messages.html.j2" %}
{%- if download_archives %}
{%- set download_archive = download_archives | selectattr("format", "equalto", "zip") | first %}
{%- endif %}
<div id="{{ button_id }}" class="flex w-full justify-center items-center">
    {%- if download_archive and download_archive.status in ("pending", "processing") %}
    <div class="relative w-full"
        hx-trigger="every 2s"
        hx-get="{{ request.url_for('update_archive_status_get', download_archive_id=download_archive.id) }}"
        hx-select="#{{ button_id }}"
        hx-target="#{{ button_id }}"
        hx-target-4*="#{{ button_id }}">
        {%- if download_archive.status == "pending" %}
        <div class="flex split-button split-button-neutral md:max-lg:split-button-md justify-between">
            <button style="cursor: wait;" class="split-button-action w-full text-center">Archive queued...</button>
            <button type="button"
                class="flex items-center px-2 rounded-r-md cursor-pointer transition-colors hover:bg-red-300"
                aria-label="Cancel queued download"
                title="Cancel queued download"
                hx-post="{{ request.url_for('cancel_pending_archive_post', download_archive_id=download_archive.id) }}"
                hx-swap="none">
                <svg class="size-6 stroke-[1.5]" fill="currentColor" aria-hidden="true">
                    <use href="#material-symbols-outlined-cancel"></use>
                </svg>
            </button>
        </div>
        {%- else %}
        <div class="flex split-button split-button-neutral md:max-lg:split-button-md justify-between">
            <button style="cursor: wait;" class="split-button-action w-full text-center">Archive processing...</button>
            <button type="button" style="cursor: wait;" class="split-button-toggle">
                <svg class="size-6 stroke-[1.5] animate-spin" fill="currentColor" aria-hidden="true">
                    <use href="#material-symbols-outlined-progress-activity"></use>
                </svg>
            </button>
        </div>
        {%- endif %}
    </div>
    {%- else %}
    <div class="relative w-full" x-data="{ open: false }">
        <div class="flex split-button split-button-ok md:max-lg:split-button-md justify-between">
            {%- if download_archive and download_archive.status == "ready" %}
            <a href="{{ request.url_for('download_archive_get', download_archive_id=download_archive.id, download_archive_filename=download_archive.filename) }}"
                class="w-full split-button-action text-center">
                Download {{ selection_detail.upload_count }} Items
            </a>
            {%- else %}
            <button type="button"
                class="split-button-action w-full text-center"
                hx-post="{{ request.url_for('request_uploads_archive_post', download_format='zip') }}"
                hx-target="#{{ button_id }}"
                hx-target-4*="#messages"
                {%- if hx_vals %}hx-vals="{{ hx_vals | tojson | e }}"{% endif %}
                {%- if hx_include %}hx-include="{{ hx_include }}"{% endif %}
                hx-select="#{{ button_id }} > div">
                Download {{ selection_detail.upload_count }} Items
            </button>
            {%- endif %}
            <button type="button"
                    class="split-button-toggle"
                    aria-label="Toggle download options"
                    @click="open = !open;">
                <svg class="size-4" aria-hidden="true"><use href="#material-symbols-outlined-arrow-drop-down"></use></svg>
            </button>
        </div>
        <ul role="menu"
            class="menu absolute w-fit max-h-64 overflow-y-auto z-10"
            aria-label="Download options"
            x-cloak
            x-show="open"
            @click="open = false"
            @click.outside="open = false">
            {{ multiselect_download_button_format_item(format='zip') }}
            {{ multiselect_download_button_format_item(format='tar.gz') }}
            {{ multiselect_download_button_format_item(format='tar.bz2') }}
            {{ multiselect_download_button_format_item(format='tar.zstd') }}
        </ul>
    </div>
    {%- endif %}
</div>
