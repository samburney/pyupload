{% macro render_combo_selector() %}
<div id="collections-combo-selector" class="relative input w-full"
    x-data="multiSelectCombo">
    <label class="text-xs text-gray-700 font-medium" for="collection_name">Collections</label>
    <fieldset class="mt-1 w-full min-w-0">
        <legend class="sr-only">Collections</legend>
        <div class="split-button split-button-neutral max-lg:split-button-md w-full max-w-full">
            <div class="split-button-label w-full truncate" x-text="buttonText"></div>
            <button class="split-button-toggle"
                    type="button"
                    aria-label="Toggle collections menu"
                    @click="menu = !menu">
                <svg fill="none" stroke="currentColor" class="size-4" aria-hidden="true"><use href="#icon-chevron-down"></use></svg>
            </button>
        </div>
        <div
            class="absolute whitespace-nowrap overflow-hidden w-fit max-h-64 end-0 mt-0.5 z-50 rounded border border-gray-300 bg-white shadow-sm"
            x-show="menu"
            x-cloak
            @click.outside="menu = false">
            <ul id="collections-combo-selector-search"
                class="border-b border-gray-300 mb-0.5">
                <li class="menu-item rounded-t-md focus-within:outline-2 focus-within:-outline-offset-4 focus-within:outline-blue-500">
                    <label class="flex items-center gap-2" aria-label="Search collections">
                        <button class="text-green-500 h-3.5 w-3.5 m-0.5 p-0" type="button" aria-label="Add as new collection"
                                x-cloak
                                x-bind:class="isNewCollection ? 'visible cursor-pointer' : 'invisible cursor-default'"
                                x-bind:disabled="!isNewCollection"
                                hx-post="/uploads/{{ upload.id }}/collection"
                                hx-include="next input[name='collection_name']"
                                hx-select="#collections-combo-selector"
                                hx-target="#collections-combo-selector"
                                hx-swap="innerHTML"
                                hx-select-oob="#messages"
                                hx-target-4*="#messages">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        </button>
                        <input class="text-sm p-0 m-0 ring-0 bg-transparent border-none field-sizing-content min-w-3xs
                        placeholder:text-gray-500 placeholder:italic"
                            type="text" id="collection_name" name="collection_name" placeholder="Search existing, or add to a new collection..."
                            x-model="search"
                            @keyup.enter="$event.preventDefault(); if (event.target.value.trim() !== '') { htmx.trigger(htmx.find(htmx.find('#collections-combo-selector-search'), 'button'), 'click'); }"
                            hx-trigger="change, keyup changed delay:200ms"
                            hx-post="/uploads/{{ upload.id }}/collection-search"
                            hx-target="#collections-combo-selector-options">
                    </label>
                </li>
            </ul>
            <ul id="collections-combo-selector-options"
                class="max-h-54 divide-y divide-gray-200 overflow-y-auto">
                {% include "components/collections/combo-selector-items.html.j2" %}
            </ul>
            <div id="collections-loading" class="absolute top-0 left-0 bg-black/10 w-full h-full flex justify-center items-center htmx-indicator">
                <svg class="size-6 animate-spin text-blue-500" fill="none" viewBox="0 0 24 24"><use href="#icon-loading-spinner"></use></svg>
            </div>
        </div>
    </fieldset>
</div>
{% endmacro -%}

{# Handle HTMX partial request #}
{%- if request and request.headers.get('hx-target', '') == 'collections-combo-selector-options' %}
{{ render_combo_selector() }}
{% endif %}
