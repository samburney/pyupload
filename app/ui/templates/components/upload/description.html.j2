{% if current_user and upload.user.id == current_user.id %}
<div id="upload-description" class="relative w-full max-h-fit"
    x-data="{ showEditBtn: false, editMode: false }"
    @mouseenter="if (!editMode) { showEditBtn = true }"
    @mouseleave="if (!editMode) { showEditBtn = false }"
    @htmx:after-swap="if ($event.detail.xhr.status === 200) { editMode = false; }">
    <p class="text-xs font-semibold wrap-break-word"
        x-show="!editMode">
        {{ upload.display_name | upper | replace("_", " ") }}
    </p>
    <div class="flex gap-2 w-full max-h-fit items-center justify-between">
        <textarea name="description"
            class="w-full max-h-fit field-sizing-content m-0 p-0.5 text-xs font-semibold whitespace-normal overflow-auto bg-transparent border-0 resize-none
                focus:outline-2 focus:outline-offset-2 focus:outline-blue-500 focus:ring-0 {{ 'border-b border-b-red-500' if validation_errors and validation_errors.description else '' }}"
            x-cloak
            x-show="editMode"
            @focus="editMode = true"
            @keyup.escape="editMode = false; showEditBtn = false; $el.blur()"
            :class="editMode ? 'bg-white p-1 border border-gray-500 shadow-md ring-0' : ''">
            {{- upload.display_name -}}
        </textarea>
        <button type="button" class="min-w-fit max-h-fit p-1 rounded-sm shadow-sm bg-blue-500"
            x-cloak
            x-show="editMode"
            hx-include="textarea[name=description]"
            hx-patch="/uploads/{{ upload.id }}/description"
            hx-select="#upload-description > *"
            hx-target="#upload-description"
            hx-target-400="#upload-description"
            hx-swap="innerHTML">
            <svg class="size-4 fill-white" viewBox="0 0 24 24">
                <use href="#material-symbols-outlined-save"></use>
            </svg>
        </button>
    </div>
    <div class="absolute bg-white/75 top-0 left-0 flex w-full h-full items-center justify-center shadow-md rounded-sm"
        x-show="showEditBtn"
        x-cloak
        @click="showEditBtn = false; editMode = true; $focus.focus($el.parentElement.querySelector('textarea[name=description]'))">
        <button type="button" class="size-4 fill-black">
            <svg viewBox="0 0 24 24">
                <use href="#material-symbols-outlined-edit-box"></use>
            </svg>
            <span class="sr-only">Edit description</span>
        </button>
    </div>
    {% if validation_errors %}
    <div class="validation-error wrap-break-word">{{ validation_errors.description | default(None) }}</div>
    {% endif %}
</div>
{% else %}
<p class="text-xs font-semibold wrap-break-word">
    {{ upload.display_name | upper | replace("_", " ") }}
</p>
{% endif %}
