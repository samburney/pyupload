{% if tags and tags | length > 0 %}
<article id="tags-grid"
    class="columns-1 md:columns-2 xl:columns-3 2xl:columns-4 gap-4 mb-4">
    {% for tag in tags %}
    {% include("components/tags/card.html.j2") %}
    {% endfor %}
</article>
{% else %}
<article id="tags-grid" class="flex flex-col grow justify-center items-center">
    {% include("components/common/empty-content.html.j2") %}
</article>
{% endif %}
