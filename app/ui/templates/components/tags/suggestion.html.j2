<li class="w-full p-2 m-0 text-xs"
    hx-trigger="click"
    hx-post="/tags/update"
    hx-include="[name='selected_ids']"
    hx-vals='{"tag_name": {{ tag | tojson }}}'
    hx-select="#tag-input"
    hx-target="#tag-input"
    hx-swap="outerHTML"
    hx-select-oob="#messages"
    hx-target-4*="#messages">
    <button class="w-full m-0 text-right" type="button">
        <span class="px-1 py-0.5 border shadow {{ 'border-green-500 shadow-green-300' if tag == new_tag else 'border-gray-500 shadow-gray-300' }} rounded-sm uppercase hover:bg-green-100 hover:border-green-500">
            <span class="pl-1 pr-0.5 mr-1 text-gray-500 hover:text-black hover:rounded-3xl hover:bg-green-300">
                <span class="sr-only">Add tag</span>
                &plus;
            </span>
            {{ tag }}
        </span>
    </button>
</li>
