{
  "name": "pyupload",
  "version": "0.0.1",
  "description": "Modern file/image gallery upload application",
  "scripts": {
    "watch:css": "npx @tailwindcss/cli -i ./input.css -o ./app/static/css/tailwind.css --watch=always",
    "build:css": "npx @tailwindcss/cli -i ./input.css -o ./app/static/css/tailwind.css --minify"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1",
    "tailwindcss": "^4.1"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11"
  }
}
