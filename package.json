{
  "name": "pyupload",
  "version": "0.0.1",
  "description": "Modern file/image gallery upload application",
  "scripts": {
    "copy:vendor": "node ./scripts/copy-vendor.mjs",
    "postinstall": "npm run copy:vendor",
    "watch:css": "npx @tailwindcss/cli -i ./tailwind.css -o ./app/static/css/app/tailwind.css --watch=always",
    "build:css": "npx @tailwindcss/cli -i ./tailwind.css -o ./app/static/css/app/tailwind.css --minify",
    "build:js": "npm run copy:vendor"
  },
  "dependencies": {
    "@alpinejs/focus": "^3.15.11",
    "@tailwindcss/cli": "^4.2",
    "alpinejs": "^3.15.11",
    "dropzone": "^5",
    "htmx-ext-response-targets": "^2.0.4",
    "htmx.org": "^2.0.8",
    "sweetalert2": "^11.26",
    "tailwindcss": "^4.2"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11"
  }
}
